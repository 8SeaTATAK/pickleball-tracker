<view class="page">
  <view class="card">
    <view class="field">
      <text class="label">{{t.name}}</text>
      <input placeholder="{{t.clubNamePh}}" placeholder-class="placeholder" maxlength="30" value="{{name}}" data-k="name" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">{{t.city}}</text>
      <input placeholder="{{t.optional}}" placeholder-class="placeholder" maxlength="20" value="{{city}}" data-k="city" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">{{t.intro}}</text>
      <textarea placeholder="{{t.introPh}}" placeholder-class="placeholder" maxlength="300" value="{{intro}}" data-k="intro" bindinput="onInput" />
    </view>
  </view>

  <block wx:if="{{clubId}}">
    <view class="section-title">{{t.pointsRules}}</view>
    <view class="card">
      <view class="field">
        <text class="label">{{t.perWin}}</text>
        <input type="number" value="{{winPoints}}" data-k="winPoints" bindinput="onInput" />
        <text class="muted">{{t.pts}}</text>
      </view>
      <view class="field">
        <text class="label">{{t.perLoss}}</text>
        <input type="number" value="{{lossPoints}}" data-k="lossPoints" bindinput="onInput" />
        <text class="muted">{{t.lossHint}}</text>
      </view>
      <view class="field">
        <text class="label">{{t.currency}}</text>
        <picker range="{{currencies}}" value="{{currencyIdx}}" bindchange="onCurrency">
          <view>{{currencies[currencyIdx]}} ›</view>
        </picker>
      </view>
    </view>
  </block>

  <button class="btn" bindtap="save" disabled="{{saving}}">{{clubId ? t.save : t.createClub}}</button>
</view>
