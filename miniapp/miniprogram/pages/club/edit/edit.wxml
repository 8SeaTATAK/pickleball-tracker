<view class="page">
  <view class="card">
    <view class="field">
      <text class="label">名称</text>
      <input placeholder="例如：北区匹克球俱乐部" placeholder-class="placeholder" maxlength="30" value="{{name}}" data-k="name" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">城市</text>
      <input placeholder="选填" placeholder-class="placeholder" maxlength="20" value="{{city}}" data-k="city" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">简介</text>
      <textarea placeholder="选填：常驻场馆、活动时间、水平要求…" placeholder-class="placeholder" maxlength="300" value="{{intro}}" data-k="intro" bindinput="onInput" />
    </view>
  </view>

  <block wx:if="{{clubId}}">
    <view class="section-title">积分规则</view>
    <view class="card">
      <view class="field">
        <text class="label">胜一场</text>
        <input type="number" value="{{winPoints}}" data-k="winPoints" bindinput="onInput" />
        <text class="muted">分</text>
      </view>
      <view class="field">
        <text class="label">负一场</text>
        <input type="number" value="{{lossPoints}}" data-k="lossPoints" bindinput="onInput" />
        <text class="muted">分（鼓励出勤可设为 1）</text>
      </view>
    </view>
  </block>

  <button class="btn" bindtap="save" disabled="{{saving}}">{{clubId ? '保存' : '创建俱乐部'}}</button>
</view>
