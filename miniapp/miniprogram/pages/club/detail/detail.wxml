<wxs src="../../../utils/i18n.wxs" module="i" />
<view class="page" wx:if="{{club}}">
  <view class="card">
    <view class="row gap">
      <view class="avatar big">{{club.name[0]}}</view>
      <view class="grow">
        <view class="bold title">{{club.name}}</view>
        <view class="muted">{{club.city ? club.city + ' · ' : ''}}{{i.f(t.membersN, club.memberCount)}}</view>
      </view>
      <text class="tag" wx:if="{{roleText}}">{{roleText}}</text>
    </view>
    <view class="intro" wx:if="{{club.intro}}">{{club.intro}}</view>
    <view class="row between invite" wx:if="{{myRole}}">
      <text class="muted">{{t.inviteCode}} <text class="code" bindtap="copyCode">{{club.inviteCode}}</text> {{t.tapToCopy}}</text>
      <button class="btn mini ghost" open-type="share">{{t.shareInvite}}</button>
    </view>
    <button class="btn join" wx:if="{{!myRole}}" bindtap="join">{{t.joinClub}}</button>
  </view>

  <block wx:if="{{myRole}}">
    <view class="tabs">
      <view class="tab {{tab == 'events' ? 'on' : ''}}" data-tab="events" bindtap="switchTab">{{t.tabEvents}}</view>
      <view class="tab {{tab == 'board' ? 'on' : ''}}" data-tab="board" bindtap="switchTab">{{t.tabBoard}}</view>
      <view class="tab {{tab == 'members' ? 'on' : ''}}" data-tab="members" bindtap="switchTab">{{t.tabMembers}}</view>
    </view>

    <!-- 活动 -->
    <block wx:if="{{tab == 'events'}}">
      <button class="btn" wx:if="{{isAdmin}}" bindtap="newEvent">{{t.newEvent}}</button>
      <view class="card list" wx:if="{{events.length}}">
        <view class="list-item" wx:for="{{events}}" wx:key="_id" data-id="{{item._id}}" bindtap="goEvent">
          <view class="grow">
            <view class="row">
              <text class="bold ellipsis">{{item.title}}</text>
              <text class="tag {{item.status == 'playing' ? 'clay' : item.status == 'finished' ? 'gray' : ''}}">{{item.statusText}}</text>
            </view>
            <view class="muted">{{item.when}}{{item.location ? ' · ' + item.location : ''}}</view>
          </view>
          <view class="muted">{{item.joinedCount}}/{{item.capacity}}</view>
        </view>
      </view>
      <view class="card empty list" wx:else>{{t.noClubEvents}}</view>
    </block>

    <!-- 积分榜 -->
    <block wx:if="{{tab == 'board'}}">
      <view class="tabs small-tabs">
        <view class="tab {{period == 'week' ? 'on' : ''}}" data-p="week" bindtap="switchPeriod">{{t.last7}}</view>
        <view class="tab {{period == 'month' ? 'on' : ''}}" data-p="month" bindtap="switchPeriod">{{t.last30}}</view>
        <view class="tab {{period == 'all' ? 'on' : ''}}" data-p="all" bindtap="switchPeriod">{{t.allTime}}</view>
      </view>
      <view class="card">
        <view class="table" wx:if="{{board.length}}">
          <view class="tr th">
            <text class="rank">#</text>
            <text class="name">{{t.colPlayer}}</text>
            <text class="c">{{t.colWL}}</text>
            <text class="c">{{t.colWinRate}}</text>
            <text class="c">{{t.colDiff}}</text>
            <text class="c">{{t.colPoints}}</text>
          </view>
          <view class="tr" wx:for="{{board}}" wx:key="userId" data-id="{{item.userId}}" bindtap="tapBoard">
            <text class="rank {{item.rank <= 3 ? 'top' : ''}}">{{item.rank}}</text>
            <view class="name"><text class="ellipsis">{{item.user.nickName}}</text></view>
            <text class="c">{{item.wins}}-{{item.losses}}</text>
            <text class="c">{{item.winRate}}%</text>
            <text class="c {{item.diff > 0 ? 'up' : item.diff < 0 ? 'down' : ''}}">{{item.diff > 0 ? '+' : ''}}{{item.diff}}</text>
            <text class="c bold">{{item.score}}</text>
          </view>
        </view>
        <view class="empty" wx:else>{{t.noBoard}}</view>
        <view class="muted rule" wx:if="{{settings}}">{{i.f(t.boardRule, settings.winPoints, settings.lossPoints)}}</view>
      </view>
    </block>

    <!-- 成员 -->
    <block wx:if="{{tab == 'members'}}">
      <button class="btn ghost" wx:if="{{isAdmin}}" bindtap="openGuest">{{t.addGuestBtn}}</button>
      <view class="card list">
        <view class="list-item" wx:for="{{members}}" wx:key="_id" data-i="{{index}}" bindtap="tapMember">
          <view class="avatar">
            <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" />
            <text wx:else>{{item.nickName[0]}}</text>
          </view>
          <view class="grow">
            <view class="row">
              <text class="bold ellipsis">{{item.nickName}}</text>
              <text class="tag" wx:if="{{item.roleText}}">{{item.roleText}}</text>
              <text class="tag gray" wx:if="{{item.guest}}">{{t.guest}}</text>
            </view>
            <view class="muted">{{i.f(t.memberWL, item.doubles.wins, item.doubles.losses)}}</view>
          </view>
          <view class="center">
            <view class="bold rating">{{item.ratingText}}</view>
            <view class="muted">{{t.doublesRating}}</view>
          </view>
        </view>
      </view>
    </block>

    <view class="btn-row">
      <button class="btn ghost" wx:if="{{isAdmin}}" bindtap="settingsPage">{{t.clubSettings}}</button>
      <button class="btn warn" wx:if="{{myRole != 'owner'}}" bindtap="leave">{{t.leaveClub}}</button>
    </view>
  </block>
</view>

<view class="mask" wx:if="{{showGuest}}" bindtap="closeGuest">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">{{t.addGuestTitle}}</view>
    <view class="field">
      <text class="label">{{t.guestName}}</text>
      <input placeholder="{{t.guestNamePh}}" placeholder-class="placeholder" maxlength="20" value="{{guestName}}" bindinput="onGuestName" />
    </view>
    <view class="field">
      <text class="label">{{t.startLevel}}</text>
      <picker range="{{levels}}" value="{{guestLevel}}" bindchange="onGuestLevel">
        <view>{{levels[guestLevel]}} ›</view>
      </picker>
    </view>
    <view class="muted">{{t.guestHint}}</view>
    <view class="btn-row">
      <button class="btn ghost" bindtap="closeGuest">{{t.cancel}}</button>
      <button class="btn" bindtap="addGuest" disabled="{{!guestName}}">{{t.add}}</button>
    </view>
  </view>
</view>
