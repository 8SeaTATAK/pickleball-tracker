.avatar.big { width: 120rpx; height: 120rpx; font-size: 48rpx; }
.avatar-btn { padding: 0; margin: 0; background: none; line-height: 1; width: auto; }
.avatar-btn::after { border: none; }
.name { font-size: 36rpx; }
.edit { margin-left: 16rpx; }
.name-input { font-size: 34rpx; border-bottom: 2rpx solid var(--turf); padding: 4rpx 0; }
.level .muted { margin: 8rpx 0 16rpx; }
.link { color: var(--turf); }
.stats { margin-top: 24rpx; }
.bar { height: 8rpx; background: var(--paper); border-radius: 8rpx; margin-top: 20rpx; overflow: hidden; }
.bar .fill { height: 100%; background: var(--turf); border-radius: 8rpx; }
.chart-wrap { margin-top: 24rpx; }
.chart { width: 100%; height: 300rpx; }
.wl { width: 56rpx; height: 56rpx; border-radius: 12rpx; text-align: center; line-height: 56rpx; font-weight: 700; color: #fff; flex-shrink: 0; }
.wl.w { background: var(--up); }
.wl.l { background: #c9b8a6; }
.lang { color: var(--turf); text-align: right; }
.list-link { display: flex; align-items: center; gap: 20rpx; }
.li-img { width: 48rpx; height: 48rpx; }
