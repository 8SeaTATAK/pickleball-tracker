.avatar-pick { background: none; padding: 0; margin: 0; display: flex; flex-direction: column; align-items: center; gap: 16rpx; line-height: 1.4; font-size: 26rpx; }
.avatar-pick::after { border: none; }
.avatar.huge { width: 160rpx; height: 160rpx; font-size: 64rpx; }
.link { color: var(--turf); }
.field picker { flex: 1; min-width: 0; text-align: right; }
.hint { margin: -8rpx 8rpx 24rpx; }
