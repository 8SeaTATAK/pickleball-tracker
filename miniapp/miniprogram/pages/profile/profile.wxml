<wxs src="../../utils/i18n.wxs" module="i" />
<view class="page" wx:if="{{user}}">
  <!-- 个人信息与战绩 -->
  <view class="card me">
    <view class="edit" bindtap="go" data-url="/pages/profile/edit">✎</view>
    <view class="who" bindtap="go" data-url="/pages/profile/edit">
      <view class="avatar big">
        <image wx:if="{{user.avatarUrl}}" src="{{user.avatarUrl}}" mode="aspectFill" />
        <text wx:else>{{user.nickName[0]}}</text>
      </view>
      <view class="name-row">
        <text class="bold name">{{user.nickName}}</text>
        <text class="sex m" wx:if="{{user.gender == 'm'}}">♂</text>
        <text class="sex f" wx:if="{{user.gender == 'f'}}">♀</text>
        <text class="lv">{{user.title}}</text>
      </view>
      <view class="muted">{{user.ratingsLine}}</view>
    </view>

    <view class="stats">
      <view class="half">
        <view class="kv"><view class="k">{{t.singles}}</view><view class="v">{{i.f(t.gamesCount, stats.singlesGames)}}</view></view>
        <view class="kv"><view class="k">{{t.colWinRate}}</view><view class="v">{{stats.singlesRate}}%</view></view>
      </view>
      <view class="divider"></view>
      <view class="half">
        <view class="kv"><view class="k">{{t.doubles}}</view><view class="v">{{i.f(t.gamesCount, stats.doublesGames)}}</view></view>
        <view class="kv"><view class="k">{{t.colWinRate}}</view><view class="v">{{stats.doublesRate}}%</view></view>
      </view>
    </view>
    <view class="umpire">
      <text>{{t.umpireSingles}}: <text class="v">{{i.f(t.gamesCount, stats.umpireSingles)}}</text></text>
      <text>{{t.umpireDoubles}}: <text class="v">{{i.f(t.gamesCount, stats.umpireDoubles)}}</text></text>
    </view>
    <view class="note">{{t.finishedOnly}}</view>
  </view>

  <!-- 功能宫格 -->
  <view class="card grid">
    <view class="cell" bindtap="go" data-url="/pages/mine/events/events"><image class="ic ball" src="/images/pickleball.png" /><text>{{t.menu_events}}</text></view>
    <view class="cell" bindtap="go" data-url="/pages/mine/matches/matches"><image class="ic ball" src="/images/paddle.png" /><text>{{t.menu_matches}}</text></view>
    <view class="cell" bindtap="goRating"><view class="ic c3">📈</view><text>{{t.menu_rating}}</text></view>
    <view class="cell" bindtap="go" data-url="/pages/guide/guide?topic=levels"><view class="ic c4">🏅</view><text>{{t.menu_levels}}</text></view>
    <view class="cell" bindtap="go" data-url="/pages/guide/guide?topic=formats"><view class="ic c5">🔄</view><text>{{t.menu_formats}}</text></view>
    <view class="cell" bindtap="go" data-url="/pages/guide/guide?topic=start"><view class="ic c6">🧭</view><text>{{t.menu_guide}}</text></view>
    <view class="cell" bindtap="goClubs"><view class="ic c7">🏠</view><text>{{t.myClubs}}</text></view>
    <view class="cell" bindtap="go" data-url="/pages/rules/rules"><view class="ic c8">📐</view><text>{{t.rulesLink}}</text></view>
    <button class="cell plain" open-type="contact"><view class="ic c9">💬</view><text>{{t.menu_contact}}</text></button>
  </view>

  <!-- 列表 -->
  <view class="card list">
    <view class="li" bindtap="go" data-url="/pages/profile/edit"><text class="li-ic">✏️</text><text class="grow">{{t.editProfile}}</text><text class="arrow">›</text></view>
    <button class="li plain" open-type="feedback"><text class="li-ic">✍️</text><text class="grow">{{t.menu_feedback}}</text><text class="arrow">›</text></button>
    <button class="li plain" open-type="share"><text class="li-ic">🤝</text><text class="grow">{{t.menu_invite}}</text><text class="arrow">›</text></button>
    <picker range="{{langNames}}" value="{{langIdx}}" bindchange="onLang">
      <view class="li"><text class="li-ic">🌐</text><text class="grow">{{t.language}}</text><text class="muted">{{langNames[langIdx]}}</text><text class="arrow">›</text></view>
    </picker>
  </view>
</view>
