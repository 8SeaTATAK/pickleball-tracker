<view class="page">
  <view class="card">
    <view class="h">{{t.r_t1}}</view>
    <view class="p">{{t.r_p1}}</view>
    <view class="p">{{t.r_p2}}</view>
    <view class="formula">{{t.r_f1}}</view>
    <view class="formula">{{t.r_f2}}</view>
    <view class="formula">{{t.r_f3}}</view>
    <view class="p">{{t.r_p3}}</view>
  </view>

  <view class="card">
    <view class="h">{{t.r_t2}}</view>
    <view class="table">
      <view class="tr th"><text class="name">{{t.r_colGap}}</text><text class="c w">{{t.r_colShare}}</text><text class="c w">{{t.r_colScore}}</text></view>
      <view class="tr" wx:for="{{rows}}" wx:key="diff"><text class="name">{{item.diff}}</text><text class="c w">{{item.share}}</text><text class="c w">{{item.score}}</text></view>
    </view>
    <view class="p muted">{{t.r_p4}}</view>
  </view>

  <view class="card">
    <view class="h">{{t.r_t3}}</view>
    <view class="p">{{t.r_p5}}</view>
    <view class="p">{{t.r_p6}}</view>
  </view>

  <view class="card">
    <view class="h">{{t.r_t4}}</view>
    <view class="p">{{t.r_p7}}</view>
  </view>

  <view class="card">
    <view class="h">{{t.r_t5}}</view>
    <view class="p">{{t.r_p8}}</view>
    <view class="p muted">{{t.r_disclaimer}}</view>
  </view>
</view>
