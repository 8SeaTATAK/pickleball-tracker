.title { font-size: 34rpx; }
.info { margin-top: 10rpx; font-size: 26rpx; }
.info.link { color: var(--turf); }
.note { margin-top: 16rpx; padding: 16rpx 20rpx; background: var(--paper); border-radius: 12rpx; font-size: 26rpx; white-space: pre-wrap; }

.grid { display: flex; flex-wrap: wrap; }
.cell { width: 25%; display: flex; flex-direction: column; align-items: center; padding: 12rpx 0; box-sizing: border-box; }
.cname { max-width: 150rpx; font-size: 24rpx; margin-top: 8rpx; }

.admin-row { margin: 0 0 8rpx; }

.match { padding: 20rpx 24rpx; }
.match.mine { border-left: 8rpx solid var(--turf); }
.court { margin-bottom: 8rpx; }
.team { font-size: 28rpx; }
.team.right .pname { justify-content: flex-end; }
.team.win { font-weight: 600; }
.pname { display: flex; align-items: center; gap: 8rpx; padding: 4rpx 0; }
.pname .ellipsis { max-width: 200rpx; }
.d { font-size: 20rpx; font-weight: 400; }
.score { width: 180rpx; text-align: center; font-size: 44rpx; flex-shrink: 0; }
.score .vs { font-size: 30rpx; font-weight: 600; }
.score .pred { font-size: 20rpx; }
.score .tag { margin: 6rpx 0 0; }

.mode { border: 2rpx solid var(--line); border-radius: 16rpx; padding: 16rpx 20rpx; margin-bottom: 12rpx; }
.mode.on { border-color: var(--turf); background: var(--turf-light); }
.pk { padding: 0 16rpx; color: var(--turf); }

.score-edit { display: flex; align-items: center; margin: 24rpx 0; }
.side { flex: 1; display: flex; flex-direction: column; align-items: center; min-width: 0; }
.names { text-align: center; min-height: 80rpx; max-width: 100%; }
.colon { font-size: 56rpx; color: var(--muted); padding: 0 12rpx; }
.stepper { display: flex; align-items: center; margin-top: 12rpx; }
.stepper input { width: 110rpx; height: 96rpx; text-align: center; font-size: 56rpx; font-weight: 700; border-bottom: 3rpx solid var(--turf); }
.st { width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center; border-radius: 50%; background: var(--paper); font-size: 36rpx; color: var(--turf); }
.quick { margin-top: 12rpx; padding: 4rpx 24rpx; border-radius: 999rpx; border: 2rpx solid var(--line); font-size: 24rpx; color: var(--muted); }
