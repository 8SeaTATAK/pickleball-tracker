<wxs src="../../utils/i18n.wxs" module="i" />
<view class="page">

  <view class="section-title">
    <text>{{t.upcoming}}</text>
  </view>
  <view class="card" wx:if="{{events.length}}">
    <view class="list-item" wx:for="{{events}}" wx:key="_id" data-id="{{item._id}}" bindtap="goEvent">
      <view class="grow">
        <view class="row">
          <text class="bold ellipsis">{{item.title}}</text>
          <text class="tag {{item.status == 'playing' ? 'clay' : ''}}">{{item.statusText}}</text>
          <text class="tag gray" wx:if="{{item.signText}}">{{item.signText}}</text>
        </view>
        <view class="muted">{{item.clubName}} · {{item.when}}</view>
        <view class="muted" wx:if="{{item.location}}">📍 {{item.location}}</view>
      </view>
      <view class="muted">{{item.joinedCount}}/{{item.capacity}}</view>
    </view>
  </view>
  <view class="card empty" wx:elif="{{loaded}}">{{t.noEvents}}</view>

  <view class="section-title">
    <text>{{t.myClubs}}</text>
    <text class="link" bindtap="goRules">{{t.rulesLink}}</text>
  </view>
  <view class="card" wx:if="{{clubs.length}}">
    <view class="list-item" wx:for="{{clubs}}" wx:key="_id" data-id="{{item._id}}" bindtap="goClub">
      <view class="avatar">{{item.name[0]}}</view>
      <view class="grow">
        <view class="bold ellipsis">{{item.name}}</view>
        <view class="muted">{{item.city ? item.city + ' · ' : ''}}{{i.f(t.membersN, item.memberCount)}}</view>
      </view>
      <text class="tag" wx:if="{{item.roleText}}">{{item.roleText}}</text>
    </view>
  </view>
  <view class="card empty" wx:elif="{{loaded}}">{{t.noClubs}}</view>

  <view class="btn-row">
    <button class="btn" bindtap="goCreate">{{t.createClub}}</button>
    <button class="btn ghost" bindtap="openJoin">{{t.joinByCode}}</button>
  </view>
</view>

<view class="mask" wx:if="{{showJoin}}" bindtap="closeJoin">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">{{t.enterCode}}</view>
    <input class="code-input" placeholder="{{t.codePh}}" maxlength="6" value="{{code}}" bindinput="onCode" focus />
    <view class="btn-row">
      <button class="btn ghost" bindtap="closeJoin">{{t.cancel}}</button>
      <button class="btn" bindtap="join" disabled="{{!code}}">{{t.join}}</button>
    </view>
  </view>
</view>
