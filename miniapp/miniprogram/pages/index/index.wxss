.hero .ratings { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); }
.code-input {
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 40rpx;
  letter-spacing: 12rpx;
  text-align: center;
  text-transform: uppercase;
  margin: 16rpx 0;
  height: 60rpx;
