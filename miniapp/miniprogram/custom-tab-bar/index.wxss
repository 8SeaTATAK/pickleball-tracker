.bar { position: fixed; left: 0; right: 0; bottom: 0; height: calc(100rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); background: #fff; display: flex; border-top: 1rpx solid #e2e0d8; }
.item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; font-size: 20rpx; color: #71776f; }
.item.on { color: #216b43; font-weight: 600; }
.icon { width: 44rpx; height: 44rpx; background-size: contain; background-repeat: no-repeat; }
.home { background-image: url("data:image/svg+xml;base64,"); }
.on .home { background-image: url("data:image/svg+xml;base64,"); }
.me { background-image: url("data:image/svg+xml;base64,"); }
.on .me { background-image: url("data:image/svg+xml;base64,"); }
.launch { justify-content: flex-end; padding-bottom: 10rpx; }
.plus { width: 88rpx; height: 88rpx; margin-top: -44rpx; border-radius: 50%; background: #216b43; color: #fff; font-size: 52rpx; line-height: 84rpx; text-align: center; box-shadow: 0 0 0 8rpx #fff, 0 6rpx 16rpx rgba(0, 0, 0, 0.15); }
